---
import MimoTtsTool from "../../components/MimoTtsTool";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="MiMo TTS 语音生成"
  description="调用小米 MiMo TTS 生成语音，支持 API Key 手动填写、整体风格配置与音频标签细粒度控制。"
>
  <div class="container mx-auto flex min-h-[calc(100vh-8rem)] flex-col px-4 py-8">
    <div class="mb-8">
      <a
        href="/"
        class="mb-4 inline-flex items-center gap-1 text-sm font-medium text-slate-500 transition-colors hover:text-brand-600 dark:hover:text-brand-400"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        ><path d="m15 18-6-6 6-6"></path></svg>
        返回首页
      </a>
      <h1 class="mb-2 text-3xl font-bold text-slate-900 dark:text-white">MiMo TTS 语音生成</h1>
      <p class="max-w-3xl text-slate-600 dark:text-slate-400">
        参考小米 MiMo TTS 的 OpenAI 兼容调用方式，在浏览器内直接生成音频。支持 API Key 手动填写、整体风格配置、正文音频标签细粒度控制，以及生成后试听下载。
      </p>
    </div>

    <div class="glass-panel relative mx-auto flex w-full max-w-7xl flex-grow flex-col overflow-hidden rounded-3xl border border-slate-200 shadow-2xl shadow-brand-500/10 dark:border-slate-800">
      <MimoTtsTool client:only="react" />
    </div>
  </div>
</Layout>
