---
import Layout from "../../layouts/Layout.astro";
import DesensitizeTool from "../../components/DesensitizeTool";
---

<Layout title="文本脱敏">
    <div
        class="container mx-auto px-4 py-8 flex flex-col min-h-[calc(100vh-8rem)]"
    >
        <div class="mb-8">
            <a
                href="/"
                class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-brand-600 dark:hover:text-brand-400 transition-colors mb-4 gap-1"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m15 18-6-6 6-6"></path></svg
                >
                返回首页
            </a>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">
                文本脱敏
            </h1>
            <p class="text-slate-600 dark:text-slate-400">
                离线脱敏处理，自动识别并遮蔽手机号、身份证、邮箱、银行卡等敏感信息。纯浏览器本地运行，数据零泄露。
            </p>
        </div>

        <div
            class="flex-grow flex flex-col relative w-full max-w-5xl mx-auto rounded-3xl glass-panel overflow-hidden shadow-2xl shadow-brand-500/10 border border-slate-200 dark:border-slate-800"
        >
            <DesensitizeTool client:only="react" />
        </div>
    </div>
</Layout>
